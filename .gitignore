# Local secrets and environment overrides
.env
.env.*
!.env.example
*.local
*.local.*

# Local AI assistant and planning workspace metadata
.codex
.codex/
.claude/
.superpowers/
.hermes/

# AI prompts and plans kept outside the product documentation.
# Directory-scoped on purpose: a bare docs/**/plan*.md would also swallow
# docs/planning-guide.md, and the pattern that quietly ignores a real document
# is the one nobody notices until the file is missing from a checkout.
docs/ai/
docs/prompts/
docs/plans/
docs/superpowers/
docs/hermes/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
*.iml

# Node/server dependencies and build output
# No trailing slash. `node_modules/` matches a directory only, and a *symlink*
# named node_modules is not a directory to git -- so one created to run the
# suite from a worktree was committed by `git add -A`, reached main, and sat
# there through two production deploys. It was harmless only because
# build-release.sh runs `npm ci` after `git archive` and overwrote it; had the
# order been reversed, production would have loaded its dependencies from a
# developer's working tree.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Anchored for the same reason as vendor/ below: unanchored, these would match
# a directory of that name anywhere, including one holding real assets.
/dist/
/*/dist/
/build/
/*/build/
coverage/

# PHP/composer dependencies and caches.
# Anchored to the root: a bare `vendor/` matches any directory of that name at
# any depth, and it silently swallowed WebAdmin/asset/vendor/leaflet -- which
# livetrack.php loads by <script src>. Staging is a git checkout so the files
# were there and the map worked; production is built with `git archive`, which
# ships only tracked files, so leaflet 404'd and the map never rendered.
/vendor/
/*/vendor/
.phpunit.result.cache

# WebAdmin runtime/uploads/backups
WebAdmin/.env
WebAdmin/.env.*
!WebAdmin/.env.example
WebAdmin/uploads/
WebAdmin/backups/
WebAdmin/*.sql
WebAdmin/backup_*.sql
WebAdmin/FULL_BACKUP_*.sql
WebAdmin/BACKUP_*.sql

# Android/Gradle generated files
.gradle/
**/.gradle/
**/build/
**/local.properties
**/captures/
**/.cxx/
**/.externalNativeBuild/
*.apk
*.aab
*.ap_
*.keystore
*.jks

# IntelliJ/Android Studio generated workspace files
.idea/
**/.idea/workspace.xml
**/.idea/tasks.xml
**/.idea/shelf/
**/.idea/caches/
**/.idea/libraries/
WebAdmin/config.php.bak.*

# Symlink runtime deployment (menunjuk /var/www/am2/shared, khusus host)
WebAdmin/update
server/update
