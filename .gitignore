# Dependency directories and build output
# Keep this unanchored so dependency symlinks are ignored as well.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Root build outputs; nested asset directories may contain tracked runtime files.
/dist/
/*/dist/
/build/
/*/build/
coverage/

# Composer dependencies and caches. Keep patterns root-anchored so tracked
# runtime assets such as WebAdmin/asset/vendor remain visible.
/vendor/
/*/vendor/
.phpunit.result.cache

# WebAdmin runtime/uploads/backups
WebAdmin/.env
WebAdmin/.env.*
!WebAdmin/.env.example
WebAdmin/uploads/
WebAdmin/backups/
WebAdmin/*.sql
WebAdmin/backup_*.sql
WebAdmin/FULL_BACKUP_*.sql
WebAdmin/BACKUP_*.sql

# Android/Gradle generated files
.gradle/
**/.gradle/
**/build/
**/local.properties
**/captures/
**/.cxx/
**/.externalNativeBuild/
*.apk
*.aab
*.ap_
*.keystore
*.jks

# IntelliJ/Android Studio generated workspace files
.idea/
WebAdmin/config.php.bak.*

# Host-managed update-channel symlinks
WebAdmin/update
server/update
