[Unit]
Description=AM2 host-security drift audit
Documentation=file:/etc/am2/host-security/README
After=network.target

[Service]
Type=oneshot
# Reads installed state and reports. It never installs, repairs, activates or
# reloads anything -- fixing drift is a decision a human makes, and an auditor
# that can also change things is one whose findings nobody has to take
# seriously.
# The trusted manifest is obtained through a channel independent of the host and
# placed here by the same approved change that installs the receipt. Without it
# the audit would be asking the host to vouch for itself.
# Every input is named explicitly. The verifier otherwise resolves its contracts
# relative to its own directory, so a bin/ layout without a sibling contracts/
# fails on every run -- and a unit that fails daily is the same lost signal as a
# unit that says nothing.
ExecStart=/etc/am2/host-security/bin/audit-host-security-drift.sh \
  --receipt /etc/am2/host-security/receipt.json \
  --expected-manifest /etc/am2/host-security/trusted-host-security-manifest.json \
  --contract /etc/am2/host-security/contracts/host-security-contract.json \
  --lifecycle /etc/am2/host-security/contracts/cloudflare-realip-lifecycle.json
# Silent when healthy, so any mail from this unit is news.
StandardOutput=null
StandardError=journal

# It only ever reads, so it is given nothing it does not need.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=
SystemCallFilter=@system-service
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
