[Unit]
Description=Alert operator after AM2 relay watchdog failure (%i)

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/am2/relay-watchdog.env
ExecStart=/usr/local/libexec/am2/send-relay-alert.sh "AM2 relay watchdog failed: %i"
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/am2-relay-watchdog
