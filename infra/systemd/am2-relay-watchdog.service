[Unit]
Description=AM2 production relay health watchdog
After=am2-api.service
OnFailure=am2-relay-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/am2/relay-watchdog.env
ExecStart=/usr/local/libexec/am2/check-relay-health.sh
StandardOutput=null
StandardError=journal
LogLevelMax=warning
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/am2-relay-watchdog
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
