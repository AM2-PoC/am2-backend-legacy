#!/usr/bin/env python3
"""What the handsets say about VOX, from the relay's journal.

The same aggregation was written by hand twice, slightly differently both
times. The numbers this prints decide whether MIN_THRESHOLD can move, so they
should be produced the same way each time they are quoted.

Usage: vox-report [since]        e.g. vox-report '2 hours ago'
"""
import re
import subprocess
import sys
from collections import Counter

FIELD = re.compile(r"(\w+)=(\S+)")


def samples(since):
    out = subprocess.run(
        ["journalctl", "-u", "am2-api", "-u", "am2-api-staging",
         "--since", since, "--no-pager", "-o", "short-iso"],
        capture_output=True, text=True,
    ).stdout
    for line in out.splitlines():
        if "event=vox_level" not in line:
            continue
        row = dict(FIELD.findall(line[line.index("event=vox_level"):]))
        row["at"] = line.split()[0]
        yield row


def num(row, key):
    try:
        return int(row.get(key, 0))
    except ValueError:
        return 0


def spread(name, values):
    if not values:
        return f"  {name:<9} (tidak ada)"
    v = sorted(values)
    return (f"  {name:<9} n={len(v):<4} min={v[0]:<7} "
            f"median={v[len(v) // 2]:<7} max={v[-1]}")


def main():
    since = sys.argv[1] if len(sys.argv) > 1 else "1 day ago"
    rows = list(samples(since))
    if not rows:
        print(f"Tidak ada sampel vox_level sejak {since}.")
        print("Handset perlu build yang mengirim telemetri ini, dan VOX harus aktif.")
        return 1

    print(f"{len(rows)} sampel sejak {since}\n")

    for state, label in (("false", "diam"), ("true", "bicara")):
        sub = [r for r in rows if r.get("talking") == state]
        print(f"{label} (talking={state})")
        print(spread("peak", [num(r, "peak") for r in sub]))
        # Absent on builds before the floor was measured; skip rather than
        # print a column of zeroes that reads like a measurement.
        if any("mean" in r for r in sub):
            print(spread("mean", [num(r, "mean") for r in sub]))
            print(spread("floor", [num(r, "floor") for r in sub]))
        print()

    thresholds = Counter(r.get("threshold") for r in rows)
    print("threshold: " + ", ".join(f"{t} (x{n})" for t, n in thresholds.most_common()))
    if set(thresholds) == {"500"}:
        print("  -> 500 adalah MIN_THRESHOLD: slider di 100/100, tidak ada sisa jalan.")

    blocks = {k: sum(num(r, k) for r in rows)
              for k in ("blocked_others", "blocked_playback",
                        "blocked_tone", "blocked_interval")}
    if any(blocks.values()):
        print("\nframe cukup keras yang DITOLAK, per penjaga:")
        for k, v in sorted(blocks.items(), key=lambda kv: -kv[1]):
            print(f"  {k:<18} {v}")
    elif any("blocked_others" in r for r in rows):
        print("\nTidak ada frame keras yang ditolak penjaga mana pun.")
        print("  -> kalau VOX tetap tuli, sebabnya ambang, bukan penjaga.")
    else:
        print("\n(build ini belum melaporkan sebab penolakan)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
