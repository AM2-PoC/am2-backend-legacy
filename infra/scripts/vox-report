#!/usr/bin/env python3
"""What the handsets say about VOX, from the relay's journal.

The same aggregation was written by hand twice, slightly differently both
times. The numbers this prints decide whether MIN_THRESHOLD can move, so they
should be produced the same way each time they are quoted.

Usage: vox-report [since]        e.g. vox-report '2 hours ago'
"""
import re
import subprocess
import sys
from collections import Counter

FIELD = re.compile(r"(\w+)=(\S+)")


def samples(since):
    try:
        run = subprocess.run(
            ["journalctl", "-u", "am2-api", "-u", "am2-api-staging",
             "--since", since, "--no-pager", "-o", "short-iso"],
            capture_output=True, text=True,
        )
    except FileNotFoundError:
        raise SystemExit("journalctl tidak ada di PATH.")
    if run.returncode != 0:
        # An empty read and a refused read look identical downstream, and the
        # message for an empty read blames the handset.
        detail = run.stderr.strip().splitlines()
        raise SystemExit(
            "journal tidak terbaca (coba dengan sudo): "
            + (detail[-1] if detail else f"journalctl keluar {run.returncode}")
        )
    out = run.stdout
    for line in out.splitlines():
        if "event=vox_level" not in line:
            continue
        row = dict(FIELD.findall(line[line.index("event=vox_level"):]))
        row["at"] = line.split()[0]
        yield row


def num(row, key):
    """The value, or None when this build never reported it.

    Absent and zero are different answers. Defaulting a missing key to zero is
    what let a build that predates a field look like one measuring a genuine
    zero -- and for the block counts, that reads as "no guard refused anything",
    which is the sentence that would justify moving the threshold.
    """
    if key not in row:
        return None
    try:
        return int(float(row[key]))
    except ValueError:
        return None


def spread(name, values):
    v = sorted(x for x in values if x is not None)
    if not v:
        return f"  {name:<9} (tidak dilaporkan build ini)"
    return (f"  {name:<9} n={len(v):<4} min={v[0]:<7} "
            f"median={v[len(v) // 2]:<7} max={v[-1]}")


def main():
    since = sys.argv[1] if len(sys.argv) > 1 else "1 day ago"
    rows = list(samples(since))
    if not rows:
        print(f"Tidak ada sampel vox_level sejak {since}.")
        print("Handset perlu build yang mengirim telemetri ini, dan VOX harus aktif.")
        return 1

    print(f"{len(rows)} sampel sejak {since}\n")

    for state, label in (("false", "diam"), ("true", "bicara")):
        sub = [r for r in rows if r.get("talking") == state]
        print(f"{label} (talking={state})")
        print(spread("peak", [num(r, "peak") for r in sub]))
        # Only the rows that carry them. A window spanning a relay upgrade
        # holds both kinds, and counting the older rows as zero drags the
        # minimum to nothing -- the column of zeroes this is meant to avoid.
        for field in ("mean", "floor"):
            carried = [num(r, field) for r in sub if field in r]
            if carried:
                print(spread(field, carried))
                if len(carried) != len(sub):
                    print(f"            ({len(carried)} dari {len(sub)} sampel; "
                          "sisanya dari build sebelum field ini ada)")
            else:
                print(spread(field, []))
        print()

    thresholds = Counter(r.get("threshold") for r in rows)
    print("threshold: " + ", ".join(f"{t} (x{n})" for t, n in thresholds.most_common()))
    if set(thresholds) == {"500"}:
        print("  -> 500 adalah MIN_THRESHOLD: slider di 100/100, tidak ada sisa jalan.")

    guards = ("blocked_others", "blocked_playback", "blocked_tone", "blocked_interval")
    reporting = [r for r in rows if any(g in r for g in guards)]
    if not reporting:
        print("\n(build ini belum melaporkan sebab penolakan)")
        print("  -> jangan simpulkan penjaga tidak bersalah dari sini.")
        return 0

    blocks = {g: sum(num(r, g) or 0 for r in reporting) for g in guards}
    print(f"\nframe cukup keras yang DITOLAK, per penjaga "
          f"({len(reporting)} dari {len(rows)} sampel melaporkannya):")
    for k, v in sorted(blocks.items(), key=lambda kv: -kv[1]):
        print(f"  {k:<18} {v}")
    if not any(blocks.values()):
        print("  -> tidak ada penjaga yang menahan frame keras dalam sampel ini;")
        print("     kalau VOX tetap tuli, tersangka berikutnya adalah ambang.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
