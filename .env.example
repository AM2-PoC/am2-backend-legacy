# Copy to .env before `docker compose up`. .env is gitignored; this file is
# the only one tracked. Every default here is a placeholder for local
# development -- none of these values exist anywhere real, and the whole
# point of this file is that it never needs to.

# Postgres, shared by the db, relay and webadmin services.
DB_PASSWORD=am2devpass

# Shared secret between the panel and the relay's /api/admin/* surface.
#
# There is no mode any more. A wrong or missing credential is refused, here as
# everywhere -- which is the point of developing against this: a local panel
# that let unauthenticated calls through would teach you the wrong thing, and
# that is exactly how production came to serve them for weeks.
AM2_API_KEY=dev-local-key

# Host ports. Change these if something on your machine already uses them.
WEBADMIN_PORT=8080
RELAY_PORT=5000
DB_PORT=5433
REDIS_PORT=6380
